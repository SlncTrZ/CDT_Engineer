{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interior Casework Layout Skill Input",
  "description": "Version 0.2.0. Critical numeric values carry field-level provenance; semantic resolution states are fail-closed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "system_id", "units", "release_target", "source_refs", "modules", "equipment"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "system_id": {"type": "string", "minLength": 1},
    "units": {"enum": ["mm", "cm", "m", "in", "ft"]},
    "release_target": {"enum": ["concept", "technical_draft", "design_review"]},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "modules": {
      "type": "array",
      "items": {"$ref": "#/$defs/module"}
    },
    "equipment": {
      "type": "array",
      "items": {"$ref": "#/$defs/equipment"}
    }
  },
  "$defs": {
    "release_class": {"enum": ["concept", "technical_draft", "design_review"]},
    "evidence_number": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "source_ref", "approved_by"],
      "properties": {
        "status": {"enum": ["observed", "specified", "derived", "inferred", "unknown", "approved_assumption"]},
        "value": {"type": ["number", "null"]},
        "source_ref": {"type": ["string", "null"], "minLength": 1},
        "approved_by": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unknown"}}, "required": ["status"]},
          "then": {"properties": {"value": {"type": "null"}, "source_ref": {"type": "null"}, "approved_by": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["observed", "specified", "derived", "inferred"]}}, "required": ["status"]},
          "then": {"properties": {"value": {"type": "number"}, "source_ref": {"type": "string", "minLength": 1}, "approved_by": {"type": ["string", "null"], "minLength": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "approved_assumption"}}, "required": ["status"]},
          "then": {"properties": {"value": {"type": "number"}, "source_ref": {"type": "string", "minLength": 1}, "approved_by": {"type": "string", "minLength": 1}}}
        }
      ]
    },
    "evidence_positive": {
      "allOf": [
        {"$ref": "#/$defs/evidence_number"},
        {"if": {"properties": {"status": {"not": {"const": "unknown"}}}, "required": ["status"]}, "then": {"properties": {"value": {"type": "number", "exclusiveMinimum": 0}}}}
      ]
    },
    "evidence_nonnegative": {
      "allOf": [
        {"$ref": "#/$defs/evidence_number"},
        {"if": {"properties": {"status": {"not": {"const": "unknown"}}}, "required": ["status"]}, "then": {"properties": {"value": {"type": "number", "minimum": 0}}}}
      ]
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_release", "reason", "unresolved_dependency", "replacement_required_before"],
      "properties": {
        "maximum_release": {"$ref": "#/$defs/release_class"},
        "reason": {"type": "string", "minLength": 1},
        "unresolved_dependency": {"type": "string", "minLength": 1},
        "replacement_required_before": {"$ref": "#/$defs/release_class"}
      }
    },
    "reduced_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_release", "reason"],
      "properties": {
        "maximum_release": {"$ref": "#/$defs/release_class"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "resolution_properties": {
      "type": "object",
      "properties": {
        "component_resolution": {"enum": ["resolved", "custom_allowed", "proxy_allowed_for_scope", "reduced_scope", "blocked"]},
        "component_id": {"type": ["string", "null"], "minLength": 1},
        "proxy": {"$ref": "#/$defs/proxy"},
        "reduced_scope": {"$ref": "#/$defs/reduced_scope"},
        "block_reason": {"type": "string", "minLength": 1}
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "geometry", "panels", "component_resolution", "component_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["base_cabinet", "wall_cabinet", "tall_cabinet", "corner_cabinet", "drawer_unit", "appliance_housing", "custom_casework"]},
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"enum": ["box", "corner_l"]},
            "width": {"$ref": "#/$defs/evidence_positive"},
            "height": {"$ref": "#/$defs/evidence_positive"},
            "depth": {"$ref": "#/$defs/evidence_positive"},
            "leg_a": {"$ref": "#/$defs/evidence_positive"},
            "leg_b": {"$ref": "#/$defs/evidence_positive"},
            "depth_a": {"$ref": "#/$defs/evidence_positive"},
            "depth_b": {"$ref": "#/$defs/evidence_positive"}
          },
          "allOf": [
            {"if": {"properties": {"type": {"const": "box"}}, "required": ["type"]}, "then": {"required": ["width", "height", "depth"]}},
            {"if": {"properties": {"type": {"const": "corner_l"}}, "required": ["type"]}, "then": {"required": ["leg_a", "leg_b", "depth_a", "depth_b", "height"]}}
          ]
        },
        "panels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right", "top", "bottom", "back"],
          "properties": {
            "left": {"$ref": "#/$defs/evidence_nonnegative"},
            "right": {"$ref": "#/$defs/evidence_nonnegative"},
            "top": {"$ref": "#/$defs/evidence_nonnegative"},
            "bottom": {"$ref": "#/$defs/evidence_nonnegative"},
            "back": {"$ref": "#/$defs/evidence_nonnegative"}
          }
        },
        "requirements": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum_clear_width": {"$ref": "#/$defs/evidence_nonnegative"},
            "minimum_clear_height": {"$ref": "#/$defs/evidence_nonnegative"},
            "minimum_clear_depth": {"$ref": "#/$defs/evidence_nonnegative"}
          }
        },
        "compartments": {
          "type": "object",
          "additionalProperties": false,
          "required": ["widths", "partition_thickness"],
          "properties": {
            "widths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence_positive"}},
            "partition_thickness": {"$ref": "#/$defs/evidence_nonnegative"}
          }
        },
        "panel_system_asset_id": {"type": ["string", "null"], "minLength": 1},
        "anchor_system_asset_id": {"type": ["string", "null"], "minLength": 1},
        "component_resolution": {"enum": ["resolved", "custom_allowed", "proxy_allowed_for_scope", "reduced_scope", "blocked"]},
        "component_id": {"type": ["string", "null"], "minLength": 1},
        "proxy": {"$ref": "#/$defs/proxy"},
        "reduced_scope": {"$ref": "#/$defs/reduced_scope"},
        "block_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"component_resolution": {"const": "resolved"}}, "required": ["component_resolution"]}, "then": {"properties": {"component_id": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"component_resolution": {"const": "proxy_allowed_for_scope"}}, "required": ["component_resolution"]}, "then": {"required": ["proxy"]}},
        {"if": {"properties": {"component_resolution": {"const": "reduced_scope"}}, "required": ["component_resolution"]}, "then": {"required": ["reduced_scope"]}},
        {"if": {"properties": {"component_resolution": {"const": "blocked"}}, "required": ["component_resolution"]}, "then": {"required": ["block_reason"]}}
      ]
    },
    "equipment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "envelope", "clearances", "component_resolution", "component_id"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["drawer", "appliance", "hardware", "other"]},
        "envelope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "depth"],
          "properties": {
            "width": {"$ref": "#/$defs/evidence_positive"},
            "height": {"$ref": "#/$defs/evidence_positive"},
            "depth": {"$ref": "#/$defs/evidence_positive"}
          }
        },
        "clearances": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right", "top", "bottom", "front", "back"],
          "properties": {
            "left": {"$ref": "#/$defs/evidence_nonnegative"},
            "right": {"$ref": "#/$defs/evidence_nonnegative"},
            "top": {"$ref": "#/$defs/evidence_nonnegative"},
            "bottom": {"$ref": "#/$defs/evidence_nonnegative"},
            "front": {"$ref": "#/$defs/evidence_nonnegative"},
            "back": {"$ref": "#/$defs/evidence_nonnegative"}
          }
        },
        "catalog_asset_id": {"type": ["string", "null"], "minLength": 1},
        "component_resolution": {"enum": ["resolved", "custom_allowed", "proxy_allowed_for_scope", "reduced_scope", "blocked"]},
        "component_id": {"type": ["string", "null"], "minLength": 1},
        "proxy": {"$ref": "#/$defs/proxy"},
        "reduced_scope": {"$ref": "#/$defs/reduced_scope"},
        "block_reason": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"component_resolution": {"const": "resolved"}}, "required": ["component_resolution"]}, "then": {"properties": {"component_id": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"component_resolution": {"const": "proxy_allowed_for_scope"}}, "required": ["component_resolution"]}, "then": {"required": ["proxy"]}},
        {"if": {"properties": {"component_resolution": {"const": "reduced_scope"}}, "required": ["component_resolution"]}, "then": {"required": ["reduced_scope"]}},
        {"if": {"properties": {"component_resolution": {"const": "blocked"}}, "required": ["component_resolution"]}, "then": {"required": ["block_reason"]}}
      ]
    }
  }
}
