{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Building Architecture v1 job",
  "description": "Low-rise residential architectural design/reconstruction schema. Explicit unknown/inferred states are valid data; release rules decide whether they block.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "domain_id", "release_target", "source_manifest", "units", "scope", "assumptions", "standards", "output_requirements", "building"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "job_id": {"type": "string", "minLength": 1},
    "domain_id": {"const": "building-architecture"},
    "release_target": {"$ref": "#/$defs/releaseTarget"},
    "source_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "locator", "sha256", "status", "role"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "status": {"enum": ["available", "missing", "unverified"]},
          "role": {"type": "string", "minLength": 1}
        },
        "allOf": [{
          "if": {"properties": {"status": {"const": "available"}}},
          "then": {"properties": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
        }]
      }
    },
    "units": {"enum": ["mm", "cm", "m", "in", "ft"]},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "excluded": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {"$ref": "#/$defs/evidenceStatus"},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["standard_id", "record_version", "source", "edition", "applicability", "status"],
        "properties": {
          "standard_id": {"type": "string", "minLength": 1},
          "record_version": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "edition": {"type": "string", "minLength": 1},
          "applicability": {"type": "string", "minLength": 1},
          "status": {"enum": ["proposed", "verified", "excluded"]}
        }
      }
    },
    "output_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "purpose", "required"],
        "properties": {
          "format": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    },
    "building": {
      "type": "object",
      "additionalProperties": false,
      "required": ["levels", "spaces", "walls", "openings", "stairs", "feature_inventory"],
      "properties": {
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "elevation", "evidence_status"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "elevation": {"type": "number"},
              "evidence_status": {"$ref": "#/$defs/evidenceStatus"},
              "source_ref": {"type": ["string", "null"]}
            }
          }
        },
        "spaces": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "level_id", "boundary", "evidence_status", "requirements"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "level_id": {"type": "string", "minLength": 1},
              "boundary": {"$ref": "#/$defs/polygon2d"},
              "evidence_status": {"$ref": "#/$defs/evidenceStatus"},
              "requirements": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "minimum_area": {"type": "number", "minimum": 0},
                  "minimum_clear_dimension": {"type": "number", "minimum": 0},
                  "source_ref": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "walls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "level_id", "length", "height", "thickness", "evidence_status", "structural_role"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "level_id": {"type": "string", "minLength": 1},
              "length": {"type": "number", "exclusiveMinimum": 0},
              "height": {"type": "number", "exclusiveMinimum": 0},
              "thickness": {"type": "number", "exclusiveMinimum": 0},
              "evidence_status": {"$ref": "#/$defs/evidenceStatus"},
              "structural_role": {"enum": ["unknown", "nonstructural", "structural", "inferred"]}
            }
          }
        },
        "openings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "host_wall_id", "kind", "offset", "width", "height", "sill_height", "evidence_status", "component_resolution", "component_id"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "host_wall_id": {"type": "string", "minLength": 1},
              "kind": {"enum": ["door", "window", "void", "other"]},
              "offset": {"type": "number", "minimum": 0},
              "width": {"type": "number", "exclusiveMinimum": 0},
              "height": {"type": "number", "exclusiveMinimum": 0},
              "sill_height": {"type": "number", "minimum": 0},
              "evidence_status": {"$ref": "#/$defs/evidenceStatus"},
              "component_resolution": {"$ref": "#/$defs/dependencyState"},
              "component_id": {"type": ["string", "null"]}
            }
          }
        },
        "stairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "from_level_id", "to_level_id", "from_elevation", "to_elevation", "riser_count", "riser_height", "going", "width", "evidence_status", "requirements"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "from_level_id": {"type": "string", "minLength": 1},
              "to_level_id": {"type": "string", "minLength": 1},
              "from_elevation": {"type": "number"},
              "to_elevation": {"type": "number"},
              "riser_count": {"type": "integer", "minimum": 1},
              "riser_height": {"type": "number", "exclusiveMinimum": 0},
              "going": {"type": "number", "exclusiveMinimum": 0},
              "width": {"type": "number", "exclusiveMinimum": 0},
              "evidence_status": {"$ref": "#/$defs/evidenceStatus"},
              "requirements": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "maximum_riser_height": {"type": "number", "minimum": 0},
                  "minimum_going": {"type": "number", "minimum": 0},
                  "minimum_width": {"type": "number", "minimum": 0},
                  "source_ref": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        },
        "feature_inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item_id", "semantic_family", "required", "source_evidence", "resolution_state", "implementation_state", "verification_state"],
            "properties": {
              "item_id": {"type": "string", "minLength": 1},
              "semantic_family": {"type": "string", "minLength": 1},
              "required": {"type": "boolean"},
              "source_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "resolution_state": {"$ref": "#/$defs/dependencyState"},
              "implementation_state": {"enum": ["implemented", "proxy", "missing", "not_applicable"]},
              "verification_state": {"enum": ["verified", "unverified", "not_applicable"]},
              "proxy_allowed_through": {"$ref": "#/$defs/releaseTarget"},
              "maximum_release": {"$ref": "#/$defs/releaseTarget"}
            },
            "allOf": [{
              "if": {"properties": {"required": {"const": true}}, "required": ["required"]},
              "then": {"properties": {"implementation_state": {"enum": ["implemented", "proxy", "missing"]}}}
            }]
          }
        }
      }
    }
  },
  "$defs": {
    "evidenceStatus": {"enum": ["observed", "specified", "derived", "inferred", "unknown", "approved_assumption"]},
    "dependencyState": {"enum": ["resolved", "custom_allowed", "proxy_allowed_for_scope", "reduced_scope", "blocked"]},
    "releaseTarget": {"enum": ["concept", "technical_draft", "design_review", "fabrication_or_construction_candidate", "ready_for_professional_review"]},
    "point2d": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false, "minItems": 2, "maxItems": 2},
    "polygon2d": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/point2d"}}
  }
}
