{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Site Registration Reconstruction Skill Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "release_target", "units", "source_refs", "transform", "controls", "holdouts", "tolerance"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "job_id": {"type": "string", "minLength": 1},
    "release_target": {"enum": ["concept", "technical_draft", "design_review", "fabrication_or_construction_candidate", "ready_for_professional_review"]},
    "units": {"enum": ["mm", "cm", "m", "in", "ft"]},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "transform": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"type": "number"}},
    "controls": {"$ref": "#/$defs/points"},
    "holdouts": {"$ref": "#/$defs/points"},
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "unit", "source_ref", "approved_by"],
      "properties": {
        "status": {"enum": ["unresolved", "approved"]},
        "value": {"type": ["number", "null"]},
        "unit": {"enum": ["mm", "cm", "m", "in", "ft"]},
        "source_ref": {"type": ["string", "null"], "minLength": 1},
        "approved_by": {"type": ["string", "null"], "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "approved"}}, "required": ["status"]}, "then": {"properties": {"value": {"type": "number", "exclusiveMinimum": 0}, "source_ref": {"type": "string", "minLength": 1}, "approved_by": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"status": {"const": "unresolved"}}, "required": ["status"]}, "then": {"properties": {"value": {"type": "null"}, "source_ref": {"type": "null"}, "approved_by": {"type": "null"}}}}
      ]
    },
    "feature_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "target": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
      }
    },
    "points": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/point"}}
  }
}
