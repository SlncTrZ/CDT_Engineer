{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Laser 2D-to-3D assembly job",
  "description": "Domain schema v0.1.0. Material/thickness/kerf are per-session Design Basis inputs (never hard-coded). Null or unknown values are structurally valid but block fabrication_candidate drawing release per LASER-01.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "domain_id",
    "profile_variant",
    "source_branch",
    "source_manifest",
    "units",
    "coordinate_frame",
    "material_spec",
    "scope",
    "assumptions",
    "standards",
    "output_requirements",
    "cut_plan"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "domain_id": {
      "const": "laser-2d3d-assembly"
    },
    "profile_variant": {
      "enum": ["cross-slot", "stacked-slice"],
      "description": "cross-slot = planar interlocking puzzle (Pegasus). stacked-slice = parallel contour lamination (torso)."
    },
    "source_branch": {
      "enum": ["from_3d", "from_photo"],
      "description": "from_3d = deterministic 3D source available. from_photo = single photo only, must pass artistic interpretation as proxy."
    },
    "source_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "locator", "sha256", "status", "role"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "status": {"enum": ["available", "missing", "unverified"]},
          "role": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"const": "available"}}},
            "then": {"properties": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
          }
        ]
      },
      "description": "Available inputs require verified hash before execution."
    },
    "units": {
      "enum": ["mm", "cm", "m", "in", "ft"],
      "description": "Canonical domain measurement unit; must equal coordinate_frame.target_units."
    },
    "coordinate_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_frame", "target_frame", "transform", "status", "source_units", "target_units"],
      "properties": {
        "source_frame": {"type": "string", "minLength": 1},
        "target_frame": {"type": "string", "minLength": 1},
        "transform": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"type": "number"}},
        "status": {"enum": ["proposed", "verified"]},
        "source_units": {"enum": ["mm", "cm", "m", "in", "ft"]},
        "target_units": {"enum": ["mm", "cm", "m", "in", "ft"]}
      }
    },
    "material_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_id", "thickness_mm", "kerf_mm", "slot_clearance_mm", "status"],
      "properties": {
        "material_id": {
          "type": "string",
          "minLength": 1,
          "description": "Per-session material, e.g. SUS304, plywood, MDF, acrylic, cardboard. Never a domain default."
        },
        "thickness_mm": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Sheet thickness in mm, e.g. 2.0 for SUS304, 5.0 for wood. Null = unknown, blocks fabrication_candidate."
        },
        "kerf_mm": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Laser kerf in mm for this machine/material. Null = unknown, blocks fabrication_candidate."
        },
        "slot_clearance_mm": {
          "type": ["number", "null"],
          "minimum": 0,
          "description": "Extra clearance added to slot width for assembly fit. Null = unknown, blocks fabrication_candidate."
        },
        "sheet_size": {
          "type": ["string", "null"],
          "description": "Optional sheet/bed size label, e.g. A3, 600x400."
        },
        "status": {
          "enum": ["specified", "unknown", "approved_assumption"],
          "description": "Provenance of the material triple. Only specified/approved_assumption can release beyond concept."
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "excluded": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {"enum": ["observed", "specified", "derived", "inferred", "unknown", "approved_assumption"]},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["standard_id", "record_version", "source", "edition", "applicability", "status"],
        "properties": {
          "standard_id": {"type": "string", "minLength": 1},
          "record_version": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "edition": {"type": "string", "minLength": 1},
          "applicability": {"type": "string", "minLength": 1},
          "status": {"enum": ["proposed", "verified", "excluded"]}
        }
      }
    },
    "output_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["format", "purpose", "required"],
        "properties": {
          "format": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"}
        }
      }
    },
    "cut_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features"],
      "properties": {
        "features": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "depends_on", "evidence_status"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "kind": {"type": "string", "minLength": 1},
              "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "dimension_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "evidence_status": {"enum": ["observed", "specified", "derived", "inferred", "unknown", "approved_assumption"]}
            }
          }
        }
      }
    }
  }
}
