{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Building Structural v0.2 job",
  "description": "Structural intent, coordination and bounded source-bound calculation evidence for low-rise buildings. Unknown or unverified engineering inputs remain valid evidence states but block dependent adequacy/compliance claims.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "domain_id", "release_target", "source_manifest", "units", "scope", "assumptions", "standards", "structural_basis", "grid", "members", "load_path", "architecture_interface"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "job_id": {"type": "string", "minLength": 1},
    "domain_id": {"const": "building-structural"},
    "release_target": {"$ref": "#/$defs/releaseTarget"},
    "source_manifest": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "locator", "sha256", "status", "role"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "status": {"enum": ["available", "missing", "unverified"]},
          "role": {"type": "string", "minLength": 1}
        },
        "allOf": [{"if": {"properties": {"status": {"const": "available"}}}, "then": {"properties": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}]
      }
    },
    "units": {"enum": ["mm", "cm", "m", "in", "ft"]},
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["included", "excluded"],
      "properties": {
        "included": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "excluded": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "statement", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {"$ref": "#/$defs/evidenceStatus"},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["standard_id", "record_version", "designation", "issuer", "source", "edition", "verification_status", "applicability_state", "clause_refs", "reviewer", "decision_reason"],
        "properties": {
          "standard_id": {"type": "string", "minLength": 1},
          "record_version": {"type": "string", "minLength": 1},
          "designation": {"type": "string", "minLength": 1},
          "issuer": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "edition": {"type": "string", "minLength": 1},
          "verification_status": {"enum": ["metadata_only", "source_verified", "content_verified", "superseded", "unavailable"]},
          "applicability_state": {"enum": ["applicable", "not_applicable", "unknown", "conflict"]},
          "clause_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "reviewer": {"type": "string", "minLength": 1},
          "decision_reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "structural_basis": {
      "type": "object", "additionalProperties": false,
      "required": ["structural_system", "materials", "loads", "standards_state"],
      "properties": {
        "structural_system": {"$ref": "#/$defs/evidenceValue"},
        "materials": {"$ref": "#/$defs/evidenceValue"},
        "loads": {"$ref": "#/$defs/evidenceValue"},
        "standards_state": {"$ref": "#/$defs/evidenceValue"}
      }
    },
    "analysis_evidence": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "load_cases": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["case_id", "evidence_status", "effects", "source_refs"],
            "properties": {
              "case_id": {"type": "string", "minLength": 1},
              "evidence_status": {"$ref": "#/$defs/evidenceStatus"},
              "effects": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
              "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "load_combinations": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["combination_id", "factors", "basis"],
            "properties": {
              "combination_id": {"type": "string", "minLength": 1},
              "factors": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
              "basis": {"$ref": "#/$defs/calculationBasis"}
            }
          }
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["material_id", "evidence_status", "source_ref", "properties"],
            "properties": {
              "material_id": {"type": "string", "minLength": 1},
              "evidence_status": {"$ref": "#/$defs/evidenceStatus"},
              "source_ref": {"type": "string", "minLength": 1},
              "properties": {"type": "object"}
            }
          }
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["section_id", "evidence_status", "source_ref", "material_ref", "properties"],
            "properties": {
              "section_id": {"type": "string", "minLength": 1},
              "evidence_status": {"$ref": "#/$defs/evidenceStatus"},
              "source_ref": {"type": "string", "minLength": 1},
              "material_ref": {"type": "string", "minLength": 1},
              "properties": {"type": "object"}
            }
          }
        },
        "demand_capacity_checks": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["check_id", "member_id", "demand", "capacity", "unit", "limit", "demand_evidence_status", "capacity_evidence_status", "section_ref", "material_ref", "basis"],
            "properties": {
              "check_id": {"type": "string", "minLength": 1},
              "member_id": {"type": "string", "minLength": 1},
              "demand": {"type": "number"},
              "capacity": {"type": "number", "exclusiveMinimum": 0},
              "unit": {"type": "string", "minLength": 1},
              "limit": {"type": "number", "exclusiveMinimum": 0},
              "demand_evidence_status": {"$ref": "#/$defs/evidenceStatus"},
              "capacity_evidence_status": {"$ref": "#/$defs/evidenceStatus"},
              "section_ref": {"type": "string", "minLength": 1},
              "material_ref": {"type": "string", "minLength": 1},
              "basis": {"$ref": "#/$defs/calculationBasis"}
            }
          }
        }
      }
    },
    "grid": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {
        "x": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "y": {"type": "array", "minItems": 1, "items": {"type": "number"}}
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "level_id", "bounds", "evidence_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["column", "beam", "slab", "structural_wall", "foundation_interface", "other"]},
          "level_id": {"type": "string", "minLength": 1},
          "bounds": {"$ref": "#/$defs/bounds2d"},
          "evidence_status": {"$ref": "#/$defs/evidenceStatus"},
          "section": {"type": ["object", "null"]},
          "material_ref": {"type": ["string", "null"]}
        }
      }
    },
    "load_path": {
      "type": "object", "additionalProperties": false,
      "required": ["graph", "loaded_nodes", "terminal_nodes"],
      "properties": {
        "graph": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}}},
        "loaded_nodes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "terminal_nodes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "architecture_interface": {
      "type": "object", "additionalProperties": false,
      "required": ["openings", "clearance"],
      "properties": {
        "openings": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "bounds"],
            "properties": {"id": {"type": "string", "minLength": 1}, "bounds": {"$ref": "#/$defs/bounds2d"}}
          }
        },
        "clearance": {"type": "number", "minimum": 0}
      }
    }
  },
  "$defs": {
    "releaseTarget": {"enum": ["concept", "technical_draft", "design_review", "fabrication_or_construction_candidate", "ready_for_professional_review"]},
    "evidenceStatus": {"enum": ["observed", "specified", "derived", "inferred", "unknown", "approved_assumption"]},
    "evidenceValue": {
      "type": "object", "additionalProperties": false, "required": ["status", "value"],
      "properties": {"status": {"$ref": "#/$defs/evidenceStatus"}, "value": {}, "source_ref": {"type": ["string", "null"]}}
    },
    "calculationBasis": {
      "type": "object", "additionalProperties": false,
      "required": ["source_class", "record_id", "record_version", "clause_or_rule_ref", "verification_state"],
      "properties": {
        "source_class": {"enum": ["standard_derived", "project_rule", "manufacturer", "calculation_method", "test_evidence"]},
        "record_id": {"type": "string", "minLength": 1},
        "record_version": {"type": "string", "minLength": 1},
        "clause_or_rule_ref": {"type": "string", "minLength": 1},
        "verification_state": {"enum": ["verified", "metadata_only", "unverified"]}
      }
    },
    "bounds2d": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false, "minItems": 4, "maxItems": 4}
  }
}
