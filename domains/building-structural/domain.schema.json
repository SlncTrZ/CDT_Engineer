{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Building Structural v1 job",
  "description": "Structural intent, load-path and architecture-coordination schema for low-rise buildings. Unknown loads/materials/standards remain valid evidence states but block stronger adequacy claims.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "domain_id", "release_target", "source_manifest", "units", "scope", "assumptions", "standards", "structural_basis", "grid", "members", "load_path", "architecture_interface"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "job_id": {"type": "string", "minLength": 1},
    "domain_id": {"const": "building-structural"},
    "release_target": {"$ref": "#/$defs/releaseTarget"},
    "source_manifest": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "locator", "sha256", "status", "role"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "status": {"enum": ["available", "missing", "unverified"]},
          "role": {"type": "string", "minLength": 1}
        },
        "allOf": [{"if": {"properties": {"status": {"const": "available"}}}, "then": {"properties": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}}]
      }
    },
    "units": {"enum": ["mm", "cm", "m", "in", "ft"]},
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["included", "excluded"],
      "properties": {
        "included": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "excluded": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "statement", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "status": {"$ref": "#/$defs/evidenceStatus"},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "standards": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["standard_id", "record_version", "source", "edition", "applicability", "status"],
        "properties": {
          "standard_id": {"type": "string", "minLength": 1},
          "record_version": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "edition": {"type": "string", "minLength": 1},
          "applicability": {"type": "string", "minLength": 1},
          "status": {"enum": ["proposed", "verified", "excluded"]}
        }
      }
    },
    "structural_basis": {
      "type": "object", "additionalProperties": false,
      "required": ["structural_system", "materials", "loads", "standards_state"],
      "properties": {
        "structural_system": {"$ref": "#/$defs/evidenceValue"},
        "materials": {"$ref": "#/$defs/evidenceValue"},
        "loads": {"$ref": "#/$defs/evidenceValue"},
        "standards_state": {"$ref": "#/$defs/evidenceValue"}
      }
    },
    "grid": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {
        "x": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "y": {"type": "array", "minItems": 1, "items": {"type": "number"}}
      }
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "level_id", "bounds", "evidence_status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["column", "beam", "slab", "structural_wall", "foundation_interface", "other"]},
          "level_id": {"type": "string", "minLength": 1},
          "bounds": {"$ref": "#/$defs/bounds2d"},
          "evidence_status": {"$ref": "#/$defs/evidenceStatus"},
          "section": {"type": ["object", "null"]},
          "material_ref": {"type": ["string", "null"]}
        }
      }
    },
    "load_path": {
      "type": "object", "additionalProperties": false,
      "required": ["graph", "loaded_nodes", "terminal_nodes"],
      "properties": {
        "graph": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}}},
        "loaded_nodes": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "terminal_nodes": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "architecture_interface": {
      "type": "object", "additionalProperties": false,
      "required": ["openings", "clearance"],
      "properties": {
        "openings": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "bounds"],
            "properties": {"id": {"type": "string", "minLength": 1}, "bounds": {"$ref": "#/$defs/bounds2d"}}
          }
        },
        "clearance": {"type": "number", "minimum": 0}
      }
    }
  },
  "$defs": {
    "releaseTarget": {"enum": ["concept", "technical_draft", "design_review", "fabrication_or_construction_candidate", "ready_for_professional_review"]},
    "evidenceStatus": {"enum": ["observed", "specified", "derived", "inferred", "unknown", "approved_assumption"]},
    "evidenceValue": {
      "type": "object", "additionalProperties": false, "required": ["status", "value"],
      "properties": {"status": {"$ref": "#/$defs/evidenceStatus"}, "value": {}, "source_ref": {"type": ["string", "null"]}}
    },
    "bounds2d": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "items": false, "minItems": 4, "maxItems": 4}
  }
}
