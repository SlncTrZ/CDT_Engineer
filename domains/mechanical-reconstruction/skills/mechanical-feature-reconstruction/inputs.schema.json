{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mechanical Feature Reconstruction Skill Input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "release_target", "units", "source_refs", "dimensions", "features"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "job_id": {"type": "string", "minLength": 1},
    "release_target": {"enum": ["concept", "technical_draft", "design_review", "fabrication_or_construction_candidate", "ready_for_professional_review"]},
    "units": {"enum": ["mm", "cm", "m", "in", "ft"]},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "dimensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "nominal", "source_ref", "tolerance"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "nominal": {"type": "number"},
          "source_ref": {"type": "string", "minLength": 1},
          "tolerance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "value", "unit", "source_ref", "approved_by"],
            "properties": {
              "status": {"enum": ["unresolved", "specified", "derived", "approved"]},
              "value": {"type": ["number", "null"]},
              "unit": {"enum": ["mm", "cm", "m", "in", "ft"]},
              "source_ref": {"type": ["string", "null"], "minLength": 1},
              "approved_by": {"type": ["string", "null"], "minLength": 1}
            }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "depends_on", "dimension_ids", "exactness"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "dimension_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "exactness": {"enum": ["exact", "approximation_allowed"]},
          "approved_max_deviation": {"type": ["number", "null"], "minimum": 0}
        }
      }
    },
    "required_treatments": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
