{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slnctrz.github.io/CDT_Engineer/schemas/execution-environment.schema.json",
  "title": "CDT_Engineer Execution Environment Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "host_id", "observed_at", "os", "applications", "providers"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "host_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "os": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "version", "architecture"],
      "properties": {
        "family": {"enum": ["windows", "linux", "macos", "other"]},
        "version": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1}
      }
    },
    "applications": {"type": "array", "items": {"$ref": "#/$defs/application"}},
    "providers": {"type": "array", "items": {"$ref": "#/$defs/provider"}}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"], "minLength": 1},
    "application": {
      "type": "object", "additionalProperties": false,
      "required": ["software_id", "status", "install_path", "executable_path", "version", "build", "edition", "discovery_method", "observed_at"],
      "properties": {
        "software_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["installed", "not_installed", "unknown"]},
        "install_path": {"$ref": "#/$defs/nullableString"},
        "executable_path": {"$ref": "#/$defs/nullableString"},
        "version": {"$ref": "#/$defs/nullableString"},
        "build": {"$ref": "#/$defs/nullableString"},
        "edition": {"$ref": "#/$defs/nullableString"},
        "discovery_method": {"type": "string", "minLength": 1},
        "observed_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "installed"}}, "required": ["status"]}, "then": {"properties": {"install_path": {"type": "string", "minLength": 1}, "executable_path": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"status": {"const": "not_installed"}}, "required": ["status"]}, "then": {"properties": {"install_path": {"type": "null"}, "executable_path": {"type": "null"}, "version": {"type": "null"}, "build": {"type": "null"}, "edition": {"type": "null"}}}}
      ]
    },
    "provider": {
      "type": "object", "additionalProperties": false,
      "required": ["provider_id", "software_id", "status", "provider_version", "contract_version", "discovered_capabilities", "observed_at"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1},
        "software_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["ready", "not_ready", "not_configured", "unknown"]},
        "provider_version": {"$ref": "#/$defs/nullableString"},
        "contract_version": {"$ref": "#/$defs/nullableString"},
        "discovered_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "observed_at": {"type": "string", "format": "date-time"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "ready"}}, "required": ["status"]}, "then": {"properties": {"provider_version": {"type": "string", "minLength": 1}, "contract_version": {"type": "string", "minLength": 1}, "discovered_capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}}
      ]
    }
  }
}
