{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CDT_Engineer Engineering Asset Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "version", "domain_id", "maturity", "assets"],
  "properties": {
    "schema_version": {"const": "0.2.0"},
    "catalog_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "domain_id": {"type": "string", "minLength": 1},
    "maturity": {"enum": ["draft", "pilot", "production", "deprecated"]},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "version", "family", "semantic_intent", "provenance", "applicability", "parameters", "interfaces", "allowed_transforms", "substitution_policy", "qa_checks", "native_mappings"],
        "properties": {
          "asset_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "family": {"type": "string", "minLength": 1},
          "semantic_intent": {"type": "string", "minLength": 1},
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "source", "status"],
            "properties": {
              "type": {"enum": ["generic", "manufacturer", "project", "standard_derived"]},
              "source": {"type": "string", "minLength": 1},
              "status": {"enum": ["verified", "unverified", "internal_baseline"]}
            }
          },
          "applicability": {
            "type": "object",
            "additionalProperties": false,
            "required": ["release_classes", "notes"],
            "properties": {
              "release_classes": {"type": "array", "minItems": 1, "items": {"enum": ["concept", "technical_draft", "design_review", "fabrication_or_construction_candidate", "ready_for_professional_review"]}},
              "notes": {"type": "string"}
            }
          },
          "parameters": {"type": "object"},
          "interfaces": {
            "type": "object",
            "additionalProperties": false,
            "required": ["host_types", "rules"],
            "properties": {
              "host_types": {"type": "array", "items": {"type": "string", "minLength": 1}},
              "rules": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "allowed_transforms": {"type": "array", "uniqueItems": true, "items": {"enum": ["translate", "rotate", "uniform_scale", "parameterized_resize", "mirror"]}},
          "substitution_policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["allowed", "conditions"],
            "properties": {
              "allowed": {"type": "boolean"},
              "conditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
            }
          },
          "qa_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "native_mappings": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state"],
              "properties": {
                "state": {"enum": ["unresolved", "resolved", "blocked"]},
                "asset_key": {"type": "string", "minLength": 1},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "native_version": {"type": "string", "minLength": 1},
                "reason": {"type": "string", "minLength": 1}
              },
              "allOf": [
                {
                  "if": {"properties": {"state": {"const": "resolved"}}, "required": ["state"]},
                  "then": {"required": ["asset_key", "sha256", "native_version"]}
                },
                {
                  "if": {"properties": {"state": {"const": "unresolved"}}, "required": ["state"]},
                  "then": {
                    "required": ["reason"],
                    "not": {"anyOf": [{"required": ["asset_key"]}, {"required": ["sha256"]}, {"required": ["native_version"]}]}
                  }
                },
                {
                  "if": {"properties": {"state": {"const": "blocked"}}, "required": ["state"]},
                  "then": {
                    "required": ["reason"],
                    "not": {"anyOf": [{"required": ["asset_key"]}, {"required": ["sha256"]}, {"required": ["native_version"]}]}
                  }
                }
              ]
            }
          }
        }
      }
    }
  }
}
